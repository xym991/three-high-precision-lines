{
  "name": "three-high-precision-lines",
  "version": "0.1.3",
  "description": "Camera-relative high precision lines for Three.js",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch"
  },
  "peerDependencies": {
    "three": "^0.184.0"
  },
  "keywords": [
    "three",
    "threejs",
    "webgl",
    "graphics",
    "lines",
    "precision"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xym991/three-high-precision-lines.git"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
